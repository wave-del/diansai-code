# 本次启动的任务名称；必须已在 ec_26_e.tasks.registry 注册
EC_TASK=task1

# 所选任务的 JSON；省略时自动使用 configs/tasks/<EC_TASK>.json
EC_TASK_CONFIG=configs/tasks/task1.json

# 测试用实时视觉绘制和屏幕显示；正式任务默认关闭
EC_DRAW_ENABLED=false

# 摄像头 V4L2 设备路径；多摄像头环境建议改用 /dev/v4l/by-id/ 下的稳定路径
CAMERA_DEVICE_PATH=/dev/video0

# 摄像头采集清晰度（宽×高）
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# 摄像头采集帧率、V4L2 输入格式和 FFmpeg 可执行文件
CAMERA_FPS=30
CAMERA_INPUT_FORMAT=mjpeg
CAMERA_FFMPEG_EXECUTABLE=ffmpeg

# 相机启动首帧和普通读取的默认超时；Task1 另有单帧审查读取超时
CAMERA_STARTUP_TIMEOUT_SECONDS=5.0
CAMERA_READ_TIMEOUT_SECONDS=2.0

# 蓝色 A4 工作区定位分辨率，应保持摄像头宽高比且不超过采集尺寸
WORKSPACE_DETECT_WIDTH=640
WORKSPACE_DETECT_HEIGHT=360

# 透视校正后的横向 A4 分辨率，默认使用推荐档
A4_RESIZE_WIDTH=764
A4_RESIZE_HEIGHT=540

# Task1 兼容的纸片识别模式覆盖：1=纯色白纸，2=带图案纸片。
# 新任务应在 configs/tasks/<task>.json 中设置 detect1.piece_mode；Task2
# 使用 TASK2_DETECT1_PIECE_MODE 作为独立的临时诊断覆盖，避免影响 Task1。
DETECT1_PIECE_MODE=2
TASK2_DETECT1_PIECE_MODE=1

# Task1 连续稳定审查周期，单位秒；必须为正数且不大于 task1.json 的总采集超时
TASK1_REVIEW_CYCLE_SECONDS=2.0

# Task1 每个周期内 A4 和每片纸最多允许的跳变/不可用帧数；0 表示不容忍
TASK1_ALLOWED_JUMP_FRAMES=5

# Task2 与 Task1 使用相同的稳定审查逻辑，但可单独调整周期和跳变额度。
TASK2_REVIEW_CYCLE_SECONDS=2.0
TASK2_ALLOWED_JUMP_FRAMES=5

# 可选的完整横向 A4 搭配（每次成对替换上方两个活动值）
# 极速
# A4_RESIZE_WIDTH=509
# A4_RESIZE_HEIGHT=360
# 经济
# A4_RESIZE_WIDTH=636
# A4_RESIZE_HEIGHT=450
# 推荐
# A4_RESIZE_WIDTH=764
# A4_RESIZE_HEIGHT=540
# 高质量
# A4_RESIZE_WIDTH=840
# A4_RESIZE_HEIGHT=594
# 高分辨率
# A4_RESIZE_WIDTH=960
# A4_RESIZE_HEIGHT=679

# Servo42C 串口运动诊断；外部脚本默认会打开该设备并发送报文
MOTION_SERIAL_DEVICE=/dev/ttyAS4
MOTION_SERIAL_BAUDRATE=115200
MOTION_SERIAL_READ_TIMEOUT_SECONDS=0.05
MOTION_SERIAL_WRITE_TIMEOUT_SECONDS=1.0
MOTION_SERIAL_REPLY_TIMEOUT_SECONDS=1.0

# F32C 旋转轴：使用已验收的 Cubie A7Z UART3；请勿与 XY 的 ttyAS4 混用。
# 机械角度以驱动板已保存的机械零点为准，普通定位应使用 [0, 360)。
FOC_SERIAL_PORT=/dev/ttyAS3
FOC_ADDRESS=2
FOC_RPM=15
FOC_MAX_RPM=30
FOC_FEEDBACK_TIMEOUT_SECONDS=0.3
FOC_FEEDBACK_ATTEMPTS=3
# 机械正角与业务顺时针同向时为 1，反向安装时为 -1
MOTION_ROTATION_CLOCKWISE_SIGN=1

# Task1 正式运动与软件限位；磁铁 line 必须按本机 gpiochip offset 明确配置。
# 默认标定为电机组合零点到 A4 零点：X=14.5 mm、Y=6.5 mm；本机复标后可覆盖。
MOTION_X_MIN_MM=0
MOTION_X_MAX_MM=230
MOTION_Y_MIN_MM=0
MOTION_Y_MAX_MM=360
MOTION_A4_ORIGIN_X_MM=14.5
MOTION_A4_ORIGIN_Y_MM=3.5
MOTION_XY_SPEED_MM_PER_SECOND=80
MOTION_XY_FIXED_WAIT_SECONDS=1.0

# Z 角度均以本次上电初始位置为 0°参考；较大状态差由适配层分段发送
MOTION_Z_BOOT_DEGREES=0
MOTION_Z_UP_DEGREES=90
MOTION_Z_DOWN_DEGREES=0
MOTION_Z_SPEED_LEVEL=64
MOTION_Z_ENABLE_WAIT_SECONDS=1.0
MOTION_Z_MOVE_WAIT_SECONDS=1.0

# 旋转轴逆时针回零后的最小等待时间；反馈到位和该时间必须同时满足
MOTION_ROTATION_ZERO_WAIT_SECONDS=1.0

# 高电平上磁、低电平消磁；A7Z 物理引脚 3（PJ23）对应 gpiochip0 的 line=311
# 控制输入必须具有物理下拉
MOTION_MAGNET_GPIO_CHIP=/dev/gpiochip0
MOTION_MAGNET_GPIO_LINE=311
MOTION_MAGNET_ATTACH_WAIT_SECONDS=0.3
MOTION_MAGNET_RELEASE_WAIT_SECONDS=0.3
